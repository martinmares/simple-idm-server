{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            ug.user_id,\n            u.username,\n            u.email,\n            ug.group_id,\n            g.name as group_name\n        FROM user_groups ug\n        JOIN users u ON u.id = ug.user_id\n        JOIN groups g ON g.id = ug.group_id\n        WHERE ug.tenant_id = $1\n        ORDER BY u.username, g.name\n        LIMIT $2 OFFSET $3\n        ",
