# Git
.git
.gitignore

# Rust
target/
# Keep only the statically linked workload token proxy release binary for
# Dockerfile-token-proxy. Every other build artifact stays excluded.
!target/
target/*
!target/x86_64-unknown-linux-musl/
target/x86_64-unknown-linux-musl/*
!target/x86_64-unknown-linux-musl/release/
target/x86_64-unknown-linux-musl/release/*
!target/x86_64-unknown-linux-musl/release/simple-idm-token-proxy
**/*.rs.bk
*.pdb

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Environment
.env
.env.local

# Keys (these should be mounted at runtime)
keys/*.pem

# Documentation
docs/
README.md

# CI/CD
.gitlab-ci.yml
.github/

# Tests
tests/
tmp/

# Images
images/

# Claude
.claude/
