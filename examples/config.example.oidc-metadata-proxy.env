# Public read-only OIDC/JWKS metadata proxy.
# Intended for exposing Kubernetes/OpenShift service-account token metadata
# to services running outside the cluster.

SIMPLE_IDM_OIDC_METADATA_PROXY_LISTEN=0.0.0.0:8080
SIMPLE_IDM_OIDC_METADATA_PROXY_UPSTREAM_BASE_URL=https://kubernetes.default.svc
# Optional. Use when JWKS is available only on a different API endpoint.
# SIMPLE_IDM_OIDC_METADATA_PROXY_UPSTREAM_JWKS_URL=https://api.example.com:6443/openid/v1/jwks
SIMPLE_IDM_OIDC_METADATA_PROXY_PUBLIC_BASE_URL=https://jwks-metadata.apps.example.com

# Keep issuer unchanged by default. Set only if you intentionally want
# discovery issuer rewriting and know it still matches accepted tokens.
# SIMPLE_IDM_OIDC_METADATA_PROXY_ISSUER_OVERRIDE=https://kubernetes.default.svc

SIMPLE_IDM_OIDC_METADATA_PROXY_CACHE_TTL_SECONDS=300
SIMPLE_IDM_OIDC_METADATA_PROXY_TIMEOUT_SECONDS=10

# Use when the upstream Kubernetes/OpenShift API uses a private CA.
# SIMPLE_IDM_OIDC_METADATA_PROXY_UPSTREAM_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# Use when the upstream metadata endpoint requires an authenticated
# ServiceAccount request.
# SIMPLE_IDM_OIDC_METADATA_PROXY_UPSTREAM_BEARER_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token

# Emergency/dev only.
# SIMPLE_IDM_OIDC_METADATA_PROXY_INSECURE_UPSTREAM_TLS=false
