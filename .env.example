# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
APP_ENV=development
# Trust X-Forwarded-* headers only behind a trusted reverse proxy
TRUST_PROXY_HEADERS=false
# Force Secure cookie attribute regardless of incoming scheme/proxy headers
FORCE_SECURE_COOKIES=true

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost/simple_idm

# JWT Configuration
JWT_ISSUER=http://localhost:8080
ACCESS_TOKEN_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_SECONDS=2592000
REFRESH_TOKEN_CLEANUP_INTERVAL_SECONDS=0 # 0 = cleanup only on token requests
AUTH_SESSION_EXPIRY_SECONDS=3600 # SSO session duration (1 hour)
PASSWORD_RESET_TOKEN_EXPIRY_SECONDS=3600
PASSWORD_RESET_CLEANUP_INTERVAL_SECONDS=0
PASSWORD_RESET_MAX_PER_HOUR=5
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_KEY_ID=default-key-2025
# Optional overlap verification keys for rotation:
# format: kid=path,kid2=path2
JWT_ADDITIONAL_PUBLIC_KEYS=

# Rate limiting
RATE_LIMIT_REQUESTS_PER_SECOND=5
RATE_LIMIT_BURST_SIZE=10
# Stricter limits for /oauth2/token endpoint
RATE_LIMIT_TOKEN_ENDPOINT_REQUESTS_PER_SECOND=2
RATE_LIMIT_TOKEN_ENDPOINT_BURST_SIZE=5
# Per-identity auth protection (login/token brute-force mitigation)
AUTH_PROTECTION_ENABLED=true
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_SECONDS=900

# Device Flow Configuration
DEVICE_CODE_EXPIRY_SECONDS=600
DEVICE_CODE_POLLING_INTERVAL_SECONDS=5
DEVICE_USER_CODE_LENGTH=8
DEVICE_USER_CODE_FORMAT=XXXX-XXXX
DEVICE_CODE_CLEANUP_INTERVAL_SECONDS=3600
DEVICE_MAX_VERIFICATION_ATTEMPTS=5

# Group Patterns Configuration
# Interval for syncing user group assignments based on patterns
GROUP_PATTERNS_SYNC_INTERVAL_SECONDS=300 # 5 minutes, 0 = disabled

# Soft-delete hard purge scheduler
# If enabled, records soft-deleted longer than retention are physically removed.
SOFT_DELETE_PURGE_ENABLED=false
SOFT_DELETE_PURGE_INTERVAL_SECONDS=3600
SOFT_DELETE_RETENTION_DAYS=30

# Identity policy
# If false, interactive login accepts email only (username login is rejected)
AUTH_ALLOW_USERNAME_LOGIN=true
# Optional comma-separated whitelist of allowed login email domains.
# Empty = no restriction.
# Example: ALLOWED_EMAIL_DOMAINS=cloud-app.cz,datalite.cloud
ALLOWED_EMAIL_DOMAINS=

# AD/LDAP delegated password auth (MVP)
# If enabled and AD_AUTH_DOMAINS matches user's email domain (or is empty),
# password verification is delegated to LDAP/AD.
AD_AUTH_ENABLED=false
AD_AUTH_HOST=
AD_AUTH_PORT=636
AD_AUTH_BASE_DN=
AD_AUTH_BIND_DN=
AD_AUTH_BIND_PASSWORD=
AD_AUTH_USER_FILTER=(mail={login})
# Supported values: ldaps, starttls (MVP currently supports ldaps only)
AD_AUTH_TLS_MODE=ldaps
AD_AUTH_TIMEOUT_SECONDS=5
AD_AUTH_ALLOW_INSECURE=false
# Comma-separated email domains to route to AD auth. Empty = all domains.
AD_AUTH_DOMAINS=

# UI Branding/Theming (OAuth2/login pages)
UI_BRAND_NAME=Cloud App
UI_BRAND_DOMAIN=
# Supported values: blue, red, white, green, gold
UI_THEME=blue
# Optional path to custom CSS injected into auth pages (no recompilation needed)
UI_CUSTOM_CSS_PATH=

# Admin API Configuration
# WARNING: Change this in production! Use strong random token.
# For production, prefer using Admin M2M OAuth2 client instead.
ADMIN_ROOT_TOKEN=dev-admin-token-change-me-in-production
# Security hardening switches (default false)
# ALLOW_LEGACY_ADMIN_GROUP allows deprecated group "admin" for admin API access.
ALLOW_LEGACY_ADMIN_GROUP=false
# ALLOW_ADMIN_SUBSTRING_CLAIM allows unsafe admin fallback via claim-name substring match.
ALLOW_ADMIN_SUBSTRING_CLAIM=false

# Logging
RUST_LOG=simple_idm_server=debug,tower_http=debug
